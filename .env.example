# Server-only settings for the integrated Overview → Segment → Record dashboard.
# Enter real values directly in your Vercel project settings, then redeploy.
# Never commit secrets or paste them into chat. There is no activation flag.
# Buttons/previews work without keys; attempts name missing settings clearly.
# First create your own random lab password (32–256 characters).
# This protects configured service calls; enter it in Connections & lab access.
LAB_ACCESS_KEY=

# Overview email: Full access Resend key for sending plus status readback.
# Recipient is editable in the UI; this test route permits only LAB_EMAIL_TO.
# Use the email associated with your own Resend account (onboarding@resend.dev sender).
RESEND_API_KEY=
LAB_EMAIL_TO=

# Segment Trello task: Trello Auth API key + authorized Token + own practice list.
TRELLO_API_KEY=
TRELLO_TOKEN=
TRELLO_LIST_ID=

# Record numeric correction: run supabase/orders-setup.sql in your own project.
# Deploy supabase/orders/index.ts as ie-action-lab-orders with your lab key hash.
# URL alone does not deploy the table/function. Supabase service key stays there.
LAB_SUPABASE_URL=

# Record GitHub ISSUE (not PR): fine-grained token, Only select repositories.
# Select your own copy; repository permission Issues: Read and write.
LAB_GITHUB_TOKEN=
LAB_GITHUB_REPOSITORY=
