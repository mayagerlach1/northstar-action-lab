      "netRevenue": "revenue - refund",
      "profit": "revenue - refund - cost",
      "marginRate": "profit / netRevenue, when netRevenue is greater than zero",
      "refundRate": "refund / revenue, when revenue is greater than zero"
    },
    "alertRules": {
      "negativeMargin": "profit < 0",
      "lateDelivery": "For delivered orders: deliveredDate > promisedDate. For orders not yet delivered: asOf > promisedDate. Dates are compared as calendar dates, not browser-clock timestamps.",
      "highRefund": "refundRate >= 0.25"
    },
    "notes": [
      "Use the fixed asOf date so the classroom example does not change over time.",
      "An order can match more than one alert; count distinct orders for an overall attention metric.",
      "A late or negative-margin order indicates a reason to investigate, not proof of its cause.",
      "Use fictional data and destinations you own. Review and confirm before creating a real external result."
    ],
